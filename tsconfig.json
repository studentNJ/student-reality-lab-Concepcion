{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@web/*": ["apps/web/src/*"]
    }
  },
  "include": ["tests/**/*.ts", "apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"]
}
