{
  "name": "student-reality-lab",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm run build && npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "data:build": "python3 scripts/ingest/build_metrics.py",
    "data:refresh": "npm run data:build && npm run db:load",
    "db:generate": "npm --prefix packages/db run prisma:generate",
    "db:migrate": "npm --prefix packages/db run prisma:migrate",
    "db:push": "npm --prefix packages/db run prisma:push",
    "db:seed": "npm --prefix packages/db run prisma:seed",
    "db:load": "node scripts/ingest/load_metrics_to_db.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:dev": "npm run db:up && npm run db:push && npm run db:seed",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:push && npm run db:seed",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "vitest run tests/e2e --passWithNoTests",
    "test:e2e:browser": "playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}